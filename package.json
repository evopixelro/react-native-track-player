{
  "name": "@evopixel/react-native-track-player",
  "version": "5.0.4",
  "description": "This is a fork of react-native-track-player module",
  "main": "./lib/module/index.js",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "macos",
    "!macos/player.test.*",
    "web/**/*",
    "windows/**/*.{h,cpp,idl,def,vcxproj,filters,props,targets}",
    "windows/RNTrackPlayer.sln",
    "windows/NuGet.Config",
    "!windows/player.test.*",
    "*.podspec",
    "react-native.config.js",
    "!docs/**/*",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config .eslintrc.js src web player.test.js --max-warnings=0",
    "format": "prettier --write src web player.test.js",
    "commit": "cz",
    "hooks:install": "husky install",
    "test": "jest --runInBand",
    "test:player": "jest --runInBand --testNamePattern=\"Playback API\"",
    "test:native": "jest --runInBand --testNamePattern=\"Native patch contracts\"",
    "test:codegen": "jest --runInBand --testNamePattern=\"native specification\"",
    "test:example": "npm --prefix example test",
    "check:example": "npm --prefix example run check",
    "codegen:windows": "react-native-windows-codegen --file src/NativeTrackPlayer.ts --modulesWindows --namespace RNTrackPlayerCodegen --outputDirectory windows/RNTrackPlayer/codegen --libraryName TrackPlayerSpec --separateDataTypes",
    "test:windows": "node windows/player.test.js",
    "test:macos": "node macos/player.test.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evopixelro/react-native-track-player.git"
  },
  "keywords": [
    "react",
    "react-native",
    "track-player",
    "audio-player",
    "audio",
    "player",
    "music",
    "controls",
    "evopixel",
    "android",
    "ios",
    "windows",
    "macos",
    "web",
    "hooks"
  ],
  "author": "EvoPixel",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/evopixelro/react-native-track-player/issues"
  },
  "homepage": "https://rntp.dev/",
  "contributors": [
    {
      "name": "David Chavez",
      "url": "https://github.com/dcvz"
    },
    {
      "name": "Guilherme Chaguri",
      "url": "https://github.com/Guichaguri"
    },
    {
      "name": "Dustin Bahr"
    },
    {
      "name": "Kiryl-Sadko",
      "url": "https://github.com/Kiryl-Sadko"
    }
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-macos": "^0.81.9",
    "react-native-windows": "^0.84.0",
    "shaka-player": "^4.7.9"
  },
  "peerDependenciesMeta": {
    "react-native-macos": {
      "optional": true
    },
    "react-native-windows": {
      "optional": true
    },
    "shaka-player": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native-windows/codegen": "0.84.0",
    "@types/jest": "^29.5.5",
    "@types/react": "19.2.2",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "8.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.40.18",
    "shaka-player": "^4.15.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@1.22.22",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "types": "./lib/typescript/src/index.d.ts",
  "jest": {
    "preset": "@react-native/jest-preset",
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "babelrc": false,
          "configFile": false,
          "presets": ["module:@react-native/babel-preset"]
        }
      ]
    },
    "testMatch": [
      "<rootDir>/player.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/lib/"
    ],
    "cacheDirectory": "<rootDir>/node_modules/.cache/jest",
    "clearMocks": true
  },
  "babel": {
    "presets": ["module:react-native-builder-bob/babel-preset"]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TrackPlayerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.doublesymmetry.trackplayer"
    },
    "ios": {
      "modulesProvider": {
        "TrackPlayer": "TrackPlayer"
      }
    },
    "windows": {
      "namespace": "RNTrackPlayerCodegen",
      "outputDirectory": "windows/RNTrackPlayer/codegen",
      "separateDataTypes": true
    }
  }
}
