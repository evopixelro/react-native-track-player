{
  "name": "react-native-track-player-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:adb-reverse": "adb reverse tcp:8081 tcp:8081",
    "ios": "react-native run-ios",
    "ios:ide": "open ios/TrackPlayerExample.xcworkspace",
    "start": "react-native start",
    "web": "webpack serve --config web/webpack.config.js --mode development",
    "build:web": "webpack --config web/webpack.config.js --mode production",
    "windows": "npm --prefix windows run windows",
    "start:windows": "npm --prefix windows start",
    "build:windows": "npm --prefix windows run build",
    "bundle:windows": "npm --prefix windows run bundle",
    "macos": "npm --prefix macos run macos",
    "start:macos": "npm --prefix macos start",
    "build:macos": "npm --prefix macos run build",
    "bundle:macos": "npm --prefix macos run bundle",
    "lint": "eslint --config ../.eslintrc.js src __tests__ --max-warnings=0",
    "format": "prettier --check src __tests__",
    "format:fix": "prettier --write src __tests__",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:android": "react-native build-android --mode Debug",
    "build:ios": "react-native build-ios --mode Debug"
  },
  "dependencies": {
    "@evopixel/react-native-track-player": "link:..",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/slider": "5.2.1",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-native-vector-icons/fontawesome6": "12.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.6.0",
    "react-native-worklets": "0.12.2",
    "react-native-safe-area-context": "5.9.1",
    "shaka-player": "4.16.49"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "19.2.2",
    "babel-loader": "10.1.1",
    "html-webpack-plugin": "5.6.8",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "29.7.0",
    "prettier": "^3.0.3",
    "react-native-builder-bob": "0.40.18",
    "react-native-monorepo-config": "0.3.5",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.2"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  },
  "packageManager": "yarn@1.22.22"
}
